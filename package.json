{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:inventory": "tsc -p tsconfig.server.json && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev-inventory.mjs",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "inventory:setup": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/scripts/setup-inventory.js",
    "inventory:status": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/scripts/inventory-status.js",
    "inventory:reconcile": "node --env-file-if-exists=.env --env-file-if-exists=.env.local dist-server/scripts/reconcile-inventory.js",
    "test": "tsc -p tests/tsconfig.json && node tests/run.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.9",
    "@mui/material": "^7.3.9",
    "mui": "^0.0.1",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0"
  }
}
